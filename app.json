{
  "expo": {
    "name": "OVspot",
    "slug": "ovspot-app",
    "owner": "ovspot",
    "scheme": "ovspot",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "OVspot gebruikt je locatie om haltes dichtbij te tonen."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#185c98"
        }
      ],
      "react-native-maps"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "nl.ovspot.app"
    },
    "android": {
      "package": "nl.ovspot.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundColor": "#185c98"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "apiBase": "https://ovspot.nl/app/v1",
      "eas": {
        "projectId": "302a6122-8425-4bea-aca3-81bb5088a308"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/302a6122-8425-4bea-aca3-81bb5088a308"
    }
  }
}
